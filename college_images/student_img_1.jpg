pRect .leftBottom:focus-visible, .cropRect .rightBottom:focus-visible { out=
line: canvastext solid 2px; border-radius: 2px; box-shadow: canvas 0px 0px =
0px 4px; forced-color-adjust: none; }
}

.cropRect .left { cursor: w-resize; }

.cropRect .right { cursor: e-resize; }

