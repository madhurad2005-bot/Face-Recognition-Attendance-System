#fbdialog_thumb_container > img { max-height: 280px; max-width: 280px; }

#fbdialog_errormessage { text-align: center; color: rgb(204, 0, 0); margin-=
top: 20px; }

.b_dark #fbdialog_errormessage { color: rgb(255, 102, 102); }

.contents { font-size: 13px; color: rgb(102, 102, 102); }

.flagIcon { float: left; width: 20px; height: 20px; }

.fbdialog .title { font-size: 16px; color: rgb(0, 0, 0); padding-top: 3px; =
}

.message { padding: 15px 0px 20px; }

.buttonLink { background: rgb(245, 245, 245); border: 1px solid rgb(221, 22=
1, 221); color: rgb(102, 102, 102); cursor: pointer; font-size: 13px; line-=
height: 15px; font-weight: bold; padding: 0px 16px; border-radius: 2px; mar=
gin-left: 10px; text-align: center; text-decoration: none; display: inline-=
block; height: 32px; zoom: 1; }

.b_dark .buttonLink { background: rgb(249, 249, 249); }

.buttonLink:hover { background-color: rgb(249, 249, 249); text-decoration: =
none; color: rgb(17, 17, 17); border: 1px solid rgb(204, 204, 204); }

.b_dark .buttonLink:hover { background-color: rgb(245, 245, 245); }

#checkbox_region { margin-top: 22px; column-count: 2; }

#checkbox_region input { position: absolute; width: 16px; height: 16px; opa=
city: 0; cursor: pointer; left: 0px; top: 0px; margin: 1px; }

#checkbox_region label { display: inline; }

#fbdialog #checkbox_region label.cb_c { display: inline-block; position: re=
lative; margin: auto; cursor: pointer; font-size: 13px; line-height: 16px; =
height: 18px; clear: both; padding-bottom: 3px; }

.b_dark #fbdialog #checkbox_region label.cb_c .cb_t { color: rgb(210, 208, =
206); }

#checkbox_region .cb_c .cb_w { position: absolute; top: 0px; left: 0px; hei=
ght: 16px; width: 16px; background-color: transparent; border-radius: 2px; =
border: 1px solid rgb(145, 145, 145); }

#checkbox_region .cb_c .cb_w:hover { }

#checkbox_region .cb_c input:checked ~ .cb_w { background-color: rgb(0, 128=
, 157); border-radius: 2px; transform: rotate(0deg) scale(1); opacity: 1; b=
order: 0px; }

#checkbox_region .cb_c .cb_t { position: relative; margin-left: 20px; font-=
size: 11px; height: 16px; display: inline-block; line-height: 16px; padding=
-bottom: 0px; }

#checkbox_region .cb_c input:focus ~ .cb_w, #checkbox_region .cb_c input:fo=
cus ~ .cb_t { border: 1px dashed rgb(136, 136, 136); }

.cb_c .cb_w::after { position: absolute; content: ""; }

.cb_c input:checked ~ .cb_w::after { transform: rotate(45deg) scale(1); opa=
city: 1; left: 4px; width: 6px; height: 12px; border-style: solid; border-c=
olor: rgb(255, 255, 255); border-image: initial; border-width: 0px 2px 2px =
0px; background-color: transparent; border-radius: 0px; }

#checkbox_region > div { text-align: left; }

#fbdialog_buttons { margin-top: 17px; text-align: center; white-space: nowr=
ap; }

#fbdialog { position: fixed; top: 9%; z-index: 10001; display: none; backgr=
ound-color: rgb(255, 255, 255); border: 1px solid rgb(145, 145, 145); outli=
ne: 0px; }

.b_dark #fbdialog { background-color: rgb(59, 58, 57); }

#fbdialog > .accDialog { display: block; position: relative; }

.accDlgSf { opacity: 0; width: 0px; height: 0px; overflow: hidden; position=
: absolute; top: 0px; left: 0px; }

#fbthankyou_button { text-align: center; }

#adult_button_submit, #adult_button_cancel { width: 40%; }

#fbdialogcl { cursor: pointer; background: url("/rp/qYcgES8Jht5urvMeEO9Ms8r=
pNXE.png") -127px -17px no-repeat; float: right; height: 9px; width: 9px; t=
op: 10px; right: 10px; position: relative; }

.b_dark #fbdialogcl { background: url("/rp/qYcgES8Jht5urvMeEO9Ms8rpNXE.png"=
) -117px -17px no-repeat; }

@media (forced-colors: active) {
  #fbdialogcl { forced-color-adjust: none; background: url("/rp/qYcgES8Jht5=
urvMeEO9Ms8rpNXE.png") -97px -17px no-repeat; }
  .b_dark #fbdialogcl { background: url("/rp/qYcgES8Jht5urvMeEO9Ms8rpNXE.pn=
g") -97px -17px no-repeat; }
}

#fbdialogcl:hover { background: url("/rp/qYcgES8Jht5urvMeEO9Ms8rpNXE.png") =
-107px -17px no-repeat; }

@media (min-width: 421px) {
  #fbdialog { left: 33%; }
  .contents { margin: 0px 20px; }
  .flagIcon { margin-left: 20px; }
}

@media (max-width: 420px) {
  #fbdialog { left: 3%; }
  .contents { margin: 0px 10px; }
  .flagIcon { margin-left: 10px; margin-right: 10px; }
}

@media only screen and (max-height: 480px) {
  #fbdialog { top: 3%; line-height: 0.8em; }
  .flagIcon { width: 8px; height: 8px; }
  .message { padding: 3px 0px 4px; }
  #fbdialog_thumb_container > img { max-height: 140px; max-width: 140px; }
  .fbdialog .title { font-size: 8px; padding-top: 1px; }
  #fbdialog .contents { font-size: 6px; }
  #adult_button_submit, #adult_button_cancel { width: 30%; }
  #fbdialog .buttonLink { font-size: 6px; padding: 2px; margin-left: 3px; }
  #fbdialog_container { padding: 3px 0px 4px; }
  #fbdialog_errormessage, #checkbox_region, #fbdialog_buttons { margin-top:=
 3px; }
  #checkbox_region input { top: 1px; }
  #checkbox_region label { position: relative; bottom: 3px; }
  #checkbox_region > div { padding: 3px 0px; }
  #fbdialogcl { top: 5px; right: 5px; }
}

@media only screen and (max-height: 250px) {
  #fbdialog_thumb_container > img { max-height: 85px; max-width: 85px; }
}
